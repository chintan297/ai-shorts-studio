# Supabase project (Dashboard → Project Settings → API). Both values are safe to expose to the browser;
# security comes from Row Level Security + the pairing Edge Function, never from hiding these.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Either the legacy "anon" key or the new "publishable" key works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Leave both empty to run in local-only mock mode (no pairing / cloud sync).

# --- NOT for .env.local: these are Supabase Edge Function secrets (set with `npx supabase secrets set`) ---
# PAIRING_PEPPER=<at least 32 random characters, e.g. `openssl rand -hex 32`>
# ALLOWED_ORIGINS=https://your-deployed-app.example,http://localhost:3000   (optional, defaults to *)
